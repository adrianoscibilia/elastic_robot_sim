<!--
  MJCF model for the elastic cart robot (MuJoCo backend).

  All numeric attributes carry default values derived from settings.yaml /
  sim_common.py and can be loaded directly:

      python -m mujoco.viewer --mjcf=config/elastic_cart_mujoco.xml

  elastic_cart_robot_mujoco.py reads this file via str.format_map(); to override
  a value at runtime, replace its literal with a {placeholder} token and add the
  corresponding key to the params dict in _load_mjcf_xml().

  Default values (from settings.yaml / sim_common.py)
  ─────────────────────────────────────────────────────────────────
  timestep            0.01 s
  xy_range            -1.8 1.8  (m)
  z_range             -1.0 1.0  (m)

  mass_link_x_motor   2.0 kg    inertia_x_motor  0.0133333 kg·m²
  mass_link_x         2.0 kg    inertia_x        0.0133333 kg·m²
  mass_link_y_motor   1.5 kg    inertia_y_motor  0.01      kg·m²
  mass_link_y         2.0 kg    inertia_y        0.0133333 kg·m²
  mass_link_z_motor   0.5 kg    inertia_z_motor  0.00333333 kg·m²
  mass_link_z         0.5 kg    inertia_z        0.00333333 kg·m²

  drive_x_stiffness   5977.08 N/m   drive_x_damping  82.9968 N·s/m
  drive_y_stiffness   7162.08 N/m   drive_y_damping  154.417 N·s/m
  drive_z_stiffness   3861.11 N/m   drive_z_damping  149.131 N·s/m

  motor_kp            30000  N/m   (PD position gain)
  motor_kd            500    N·s/m (PD velocity gain)
  motor_flim          2000   N     (actuator force limit)
-->
<mujoco model="elastic_cart">

  <option timestep="0.01" gravity="0 0 -9.81" integrator="implicitfast"/>

  <visual>
    <headlight ambient="0.3 0.3 0.3" diffuse="0.6 0.6 0.6" specular="0.1 0.1 0.1"/>
    <global azimuth="150" elevation="-20"/>
    <quality shadowsize="2048"/>
    <map shadowclip="10" znear="0.01"/>
  </visual>

  <asset>
    <texture name="grid" type="2d" builtin="checker"
             rgb1="0.7 0.7 0.7" rgb2="0.9 0.9 0.9" width="512" height="512"/>
    <material name="grid_mat" texture="grid" texrepeat="4 4" reflectance="0.1"/>
  </asset>

  <worldbody>
    <!-- Floor -->
    <geom name="floor" type="plane" size="5 5 0.1"
          material="grid_mat" contype="0" conaffinity="0"/>

    <!-- Lights -->
    <light name="light_main" pos="0 0 4" dir="0 0 -1"
           diffuse="0.8 0.8 0.8" specular="0.2 0.2 0.2" castshadow="true"/>
    <light name="light_fill" pos="3 -3 3" dir="-1 1 -1"
           diffuse="0.3 0.3 0.3" specular="0.0 0.0 0.0" castshadow="false"/>

    <!-- Default camera -->
    <camera name="track_cam" pos="4 -4 3" xyaxes="1 1 0  -0.4 0.4 1"/>

    <!-- ── X axis ─────────────────────────────────────────────────── -->
    <body name="link_x_motor">
      <joint name="joint_x_motor" type="slide" axis="1 0 0"
             range="-1.8 1.8" damping="0"/>
      <inertial mass="2" pos="0 0 0"
                diaginertia="0.0133333 0.0133333 0.0133333"/>
      <geom type="box" size="0.10 0.10 0.10"
            rgba="0.3 0.5 0.8 0.9" contype="0" conaffinity="0"/>

      <body name="link_x">
        <joint name="joint_x_elastic" type="slide" axis="1 0 0"
               stiffness="5977.08" damping="82.9968"/>
        <inertial mass="2" pos="0 0 0"
                  diaginertia="0.0133333 0.0133333 0.0133333"/>
        <geom type="box" size="0.09 0.09 0.09"
              rgba="0.4 0.7 0.9 0.9" contype="0" conaffinity="0"/>

        <!-- ── Y axis ───────────────────────────────────────────── -->
        <body name="link_y_motor">
          <joint name="joint_y_motor" type="slide" axis="0 1 0"
                 range="-1.8 1.8" damping="0"/>
          <inertial mass="1.5" pos="0 0 0"
                    diaginertia="0.01 0.01 0.01"/>
          <geom type="box" size="0.08 0.08 0.08"
                rgba="0.6 0.3 0.8 0.9" contype="0" conaffinity="0"/>

          <body name="link_y">
            <joint name="joint_y_elastic" type="slide" axis="0 1 0"
                   stiffness="7162.08" damping="154.417"/>
            <inertial mass="2" pos="0 0 0"
                      diaginertia="0.0133333 0.0133333 0.0133333"/>
            <geom type="box" size="0.07 0.07 0.07"
                  rgba="0.7 0.5 0.9 0.9" contype="0" conaffinity="0"/>

            <!-- ── Z axis ─────────────────────────────────────── -->
            <body name="link_z_motor">
              <joint name="joint_z_motor" type="slide" axis="0 0 1"
                     range="-1 1" damping="0"/>
              <inertial mass="0.5" pos="0 0 0"
                        diaginertia="0.00333333 0.00333333 0.00333333"/>
              <geom type="box" size="0.06 0.06 0.06"
                    rgba="0.9 0.5 0.3 0.9" contype="0" conaffinity="0"/>

              <body name="link_z">
                <joint name="joint_z_elastic" type="slide" axis="0 0 1"
                       stiffness="3861.11" damping="149.131"/>
                <inertial mass="0.5" pos="0 0 0"
                          diaginertia="0.00333333 0.00333333 0.00333333"/>
                <geom type="box" size="0.05 0.05 0.05"
                      rgba="0.9 0.8 0.3 0.9" contype="0" conaffinity="0"/>
                <!-- payload_body inserted here by Python loader when PAYLOAD > 0 -->
              </body>

            </body>
          </body>
        </body>
      </body>
    </body>

  </worldbody>

  <!--
    PD actuators on motor joints.
    Force = motor_kp * (ctrl - q) - motor_kd * qd
    Velocity feedforward: ctrl = pos_ref + (motor_kd / motor_kp) * vel_ref
    → Force = motor_kp * (pos_ref - q) + motor_kd * (vel_ref - qd)
  -->
  <actuator>
    <general name="act_x" joint="joint_x_motor"
             gaintype="fixed"  gainprm="30000"
             biastype="affine" biasprm="0 -30000 -500"
             forcerange="-2000 2000"/>
    <general name="act_y" joint="joint_y_motor"
             gaintype="fixed"  gainprm="30000"
             biastype="affine" biasprm="0 -30000 -500"
             forcerange="-2000 2000"/>
    <general name="act_z" joint="joint_z_motor"
             gaintype="fixed"  gainprm="30000"
             biastype="affine" biasprm="0 -30000 -500"
             forcerange="-2000 2000"/>
  </actuator>

</mujoco>
