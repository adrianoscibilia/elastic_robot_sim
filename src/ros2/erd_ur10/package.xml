<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>erd_ur10</name>
  <version>0.1.0</version>
  <description>
    UR10 CB3 launch wrapping ur_robot_driver (RR_01 S3.4) and the RTDE sidecar
    logger (a second RTDE connection recording the full recipe at 125 Hz).
  </description>
  <maintainer email="adriano.scibilia@cnr.it">adriano</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_python</buildtool_depend>

  <depend>ur_robot_driver</depend>
  <depend>ur_description</depend>
  <depend>xacro</depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>python3-pandas</exec_depend>
  <exec_depend>python3-pyarrow</exec_depend>

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
