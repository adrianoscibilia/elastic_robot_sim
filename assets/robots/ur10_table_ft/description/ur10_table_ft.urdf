  <!-- Round 5, R5_07 T-14: the flange force/torque cell and the calibration
       payload it exists to measure.  Both are declared here rather than in a
       config block because they are permanently mounted hardware and the URDF
       is the single source of inertial truth (D-11).

       ft_sensor_link is the cell's *housing*, on the mounting side of the
       measurement plane, so its own 0.3 kg is deliberately not part of what
       the simulated cell reads (elastic_sim.wrench excludes the sensor link
       itself).  Generic industrial 6-axis cell, ~80 mm frame: 0.3 kg, 40 mm
       tall.  CLASS E until R5_Q Q-13 names the model.

       calibration_payload is the mass past the cell.  Without it the cell
       reads identically zero in free motion: it measures only what is
       distal to it, and the arm's own link inertia and the joint springs are
       all proximal (R5_07 Sec 1.1).  Its mass is the one knob that sets how
       much elastic content the target carries, and it is swept rather than
       guessed (R5_08 Sec 3): 5.0 kg is the value that sweep selected, half
       the UR10's 10 kg rating, leaving the sampled `payload` block as the
       smaller variable load on top.  Inertia is a 0.12 m box of that mass
       (m * 2 * 0.12^2 / 12 = 0.012). -->
  <link name="ft_sensor_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.02" />
      <mass value="0.3" />
      <inertia ixx="0.00024" ixy="0" ixz="0" iyy="0.00024" iyz="0" izz="0.00038" />
    </inertial>
  </link>
  <joint name="tool0-ft_sensor" type="fixed">
    <parent link="tool0" />
    <child link="ft_sensor_link" />
    <origin rpy="0 0 0" xyz="0 0 0" />
  </joint>

  <link name="calibration_payload">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.06" />
      <mass value="5.0" />
      <inertia ixx="0.012" ixy="0" ixz="0" iyy="0.012" iyz="0" izz="0.012" />
    </inertial>
  </link>
  <joint name="ft_sensor-calibration_payload" type="fixed">
    <parent link="ft_sensor_link" />
    <child link="calibration_payload" />
    <origin rpy="0 0 0" xyz="0 0 0.04" />
  </joint>
</robot>
