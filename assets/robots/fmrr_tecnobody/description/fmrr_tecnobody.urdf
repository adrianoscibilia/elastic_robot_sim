<?xacro version = "1.0"?>
<robot name = "fmrr_tecnobody" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- Define PI constant -->
  <xacro:property name="PI" value="3.141592653589793"/>
  
  <!-- Define materials -->
  <material name="white">
    <color rgba="1 1 1 1"/>
  </material>

  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <material name= "red">
    <color rgba="1 0 0 0"/>
  </material>

  <material name="grey_transparent">
    <color rgba="0.5 0.5 0.5 0.4"/>
  </material>

  <!--Define parameters-->
  <xacro:property name="radius" value="0.1"/>
  <xacro:property name="col_height" value="2.5"/>
  <xacro:property name="z_height" value="2"/>
  <xacro:property name="beam_lenght" value="4"/>

  <!-- Define world link -->
  <link name="world"/>

  <!--Define fixed structure links-->
  <link name="col1">
    <visual>
      <geometry>
        <cylinder length="${col_height}" radius="${radius}"/>
      </geometry>
      <material name="grey_transparent"/>
    </visual>
  <inertial><mass value="18.0"/><inertia ixx="9.59625" ixy="0" ixz="0" iyy="9.59625" iyz="0" izz="0.09"/></inertial>
  </link>

  <link name="col2">
    <visual>
      <geometry>
        <cylinder length="${col_height}" radius="${radius}"/>
      </geometry>
      <material name="grey_transparent"/>
    </visual>
  <inertial><mass value="18.0"/><inertia ixx="9.59625" ixy="0" ixz="0" iyy="9.59625" iyz="0" izz="0.09"/></inertial>
  </link>

  <link name="col3">
    <visual>
      <geometry>
        <cylinder length="${col_height}" radius="${radius}"/>
      </geometry>
      <material name="grey_transparent"/>
    </visual>
  <inertial><mass value="18.0"/><inertia ixx="9.59625" ixy="0" ixz="0" iyy="9.59625" iyz="0" izz="0.09"/></inertial>
  </link>

  <link name="beam0">
    <visual>
      <geometry>
        <cylinder length="${beam_lenght}" radius="${radius}"/>
      </geometry>
      <material name="grey_transparent"/>
    </visual>
  <inertial><mass value="12.0"/><inertia ixx="16.03" ixy="0" ixz="0" iyy="16.03" iyz="0" izz="0.06"/></inertial>
  </link>

  <link name="beam1">
    <visual>
      <geometry>
        <cylinder length="${beam_lenght}" radius="${radius}"/>
      </geometry>
      <material name="grey_transparent"/>
    </visual>
  <inertial><mass value="12.0"/><inertia ixx="16.03" ixy="0" ixz="0" iyy="16.03" iyz="0" izz="0.06"/></inertial>
  </link>

  <link name="beam2">
    <visual>
      <geometry>
        <cylinder length="${beam_lenght}" radius="${radius}"/>
      </geometry>
      <material name="grey_transparent"/>
    </visual>
  <inertial><mass value="12.0"/><inertia ixx="16.03" ixy="0" ixz="0" iyy="16.03" iyz="0" izz="0.06"/></inertial>
  </link>

  <link name="beam3">
    <visual>
      <geometry>
        <cylinder length="${beam_lenght}" radius="${radius}"/>
      </geometry>
      <material name="grey_transparent"/>
    </visual>
  <inertial><mass value="12.0"/><inertia ixx="16.03" ixy="0" ixz="0" iyy="16.03" iyz="0" izz="0.06"/></inertial>
  </link>

  <!-- Define base_link -->
  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="${col_height}" radius="${radius}"/>
      </geometry>
      <material name="white"/>
    </visual>
  <inertial><mass value="20.0"/><inertia ixx="10.6625" ixy="0" ixz="0" iyy="10.6625" iyz="0" izz="0.1"/></inertial>
  </link>

  <!-- Define link1 -->
  <link name="link1">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="white"/>
    </visual>
  <!-- CAD "red" subassembly: the whole bridge that joint_y moves, 53.2103 kg
       (assets/robots/fmrr_tecnobody/CAD_INERTIA.md, R5_04 T-6).  link1 and
       link1_beam are rigidly connected (joint_y_fixed), so they are one body
       dynamically and the split between them is arbitrary; the bridge is
       carried here and link1_beam keeps only a token mass, so the total is
       exactly the CAD's.  The tensor is the CAD's own centre-of-mass tensor
       rotated from world axes into this link's frame ; exact, because a
       prismatic chain never changes a link's orientation.  The centre of mass
       is declared at the link origin rather than at the CAD's absolute
       coordinates: reconstructing those needs the CAD assembly's joint
       positions, which the export does not state, and for three orthogonal
       prismatic joints neither the centre of mass nor the rotational inertia
       enters the joint-space dynamics (M is the constant diagonal of moved
       masses, gravity is m g . axis, Coriolis is zero).  They matter only for
       visualisation and for the end-effector wrench, and the wrench sees only
       the bodies past the sensor. -->
  <inertial>
    <mass value="53.2093"/>
    <inertia ixx="3.272" ixy="-0.9949" ixz="1.54" iyy="63.74" iyz="0.3294" izz="62.96"/>
  </inertial>
  </link>

  <link name="link1_beam">
    <visual>
      <geometry>
        <cylinder length="${beam_lenght}" radius="${radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
  <!-- Token mass: the bridge's inertia is on link1 (see above).  Kept
       non-zero so no importer sees a massless body. -->
  <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>

  <!-- Define link2 -->
  <link name="link2">
    <visual>
      <geometry>
        <box size="0.1 0.1 0.1"/>
      </geometry>
      <material name="white"/>
    </visual>
  <!-- CAD "blue" subassembly: the carriage that joint_x moves, 7.9491 kg.
       Tensor rotated into this link's frame; see link1 on the centre of mass. -->
  <inertial>
    <mass value="7.9491"/>
    <inertia ixx="0.2153" ixy="-0.0023" ixz="-0.0001" iyy="0.0463" iyz="-0.0031" izz="0.1946"/>
  </inertial>
  </link>

  <!-- Define link3 -->
  <link name="link3">
    <visual>
      <geometry>
        <cylinder length="${z_height}" radius="${radius}"/>
      </geometry>
      <material name="black"/>
    </visual>
  <!-- CAD "green" subassembly, structural part only.  The engineer's as-built
       figure for the whole vertical axis is 8.9 kg "F/T sensor, carbon poles
       and the added ballast included", of which about 5 kg is the handle
       *below* the sensor (R5_04 Sec 3, Q-8).  The 5 kg sits on ee_link, past
       ft_link, so the simulated sensor measures exactly the handle; the
       remaining 3.9 kg of column structure is here.  The tensor is the CAD
       green tensor rotated into this frame and scaled by 3.9 / 8.4898 ; the
       export does not split the tensor at the sensor plane, and the scaling is
       an approximation that does not enter the joint-space dynamics (see
       link1). -->
  <inertial>
    <mass value="3.898"/>
    <inertia ixx="0.576056" ixy="-4.59e-05" ixz="-0.0386334" iyy="0.604997" iyz="0" izz="0.0327534"/>
  </inertial>
  </link>

  <!--Define fixed structure joints-->
  <joint name="col1_joint" type="fixed">
    <parent link="world"/>
    <child link="col1"/>
    <origin xyz="${-beam_lenght} 0 0" rpy="0 0 ${PI/2.0}"/>
  </joint>

  <joint name="col2_joint" type="fixed">
    <parent link="world"/>
    <child link="col2"/>
    <origin xyz="${-beam_lenght} ${-beam_lenght} 0" rpy="0 0 ${PI/2.0}"/>
  </joint>

  <joint name="col3_joint" type="fixed">
    <parent link="world"/>
    <child link="col3"/>
    <origin xyz="0 ${-beam_lenght} 0" rpy="0 0 ${PI/2.0}"/>
  </joint>

  <joint name="beam0_joint" type="fixed">
    <parent link="base_link"/>
    <child link="beam0"/>
    <origin xyz="0 ${-beam_lenght/2} ${col_height/2}" rpy="${PI/2.0} 0 0"/>
  </joint>

  <joint name="beam1_joint" type="fixed">
    <parent link="col1"/>
    <child link="beam1"/>
    <origin xyz="${-beam_lenght/2} 0 ${col_height/2}" rpy="0 ${PI/2.0} 0"/>
  </joint>

  <joint name="beam2_joint" type="fixed">
    <parent link="col2"/>
    <child link="beam2"/>
    <origin xyz="0 ${-beam_lenght/2} ${col_height/2}" rpy="${PI/2.0} 0 0"/>
  </joint>

  <joint name="beam3_joint" type="fixed">
    <parent link="col3"/>
    <child link="beam3"/>
    <origin xyz="${beam_lenght/2} 0 ${col_height/2}" rpy="0 ${PI/2.0} 0"/>
  </joint>

  <!-- Define active joints -->
  <joint name="base2world" type="fixed">
    <parent link="world"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 ${-PI/2.0}"/>
  </joint>

  <joint name="joint_y" type="prismatic">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 ${-beam_lenght/2} ${col_height/2}" rpy="${-PI/2.0} 0 ${PI}"/>
    <axis xyz="0 0 -1"/>
    <limit lower="${-beam_lenght/2+2*radius}" upper="${beam_lenght/2-2*radius}" effort="1000" velocity="1" acceleration="0.5"/>
  </joint>

  <joint name="joint_y_fixed" type="fixed">
    <parent link="link1"/>
    <child link="link1_beam"/>
    <origin xyz="-${beam_lenght/2} 0 0" rpy="0 ${PI/2.0} ${PI}"/>
  </joint>

  <joint name="joint_x" type="prismatic">
    <parent link="link1_beam"/>
    <child link="link2"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-beam_lenght/2+2*radius}" upper="${beam_lenght/2-2*radius}" effort="1000" velocity="1" acceleration="0.5"/>
  </joint>

  <joint name="joint_z" type="prismatic">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0" rpy="-${PI/2.0} 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="${-z_height/2}" upper="${z_height/2}" effort="1000" velocity="1" acceleration="0.5"/>
  </joint>

  <joint name="flange_joint" type="fixed">
    <parent link="link3"/>
    <child link="flange_link"/>
    <origin xyz="0 0 ${-z_height/2}" rpy="0 ${PI} ${-PI/2.0}"/>
  </joint>

  <joint name="joint_yaw" type="revolute">
    <parent link="flange_link"/>
    <child link="ft_link"/>
    <origin xyz="0 0 0.04" rpy="0 0 ${PI}"/>
    <axis xyz="0 0 1"/>
    <limit lower="-${PI}" upper="${PI}" effort="1000" velocity="1"/>
  </joint>

  <!-- End-effector links.  flange_link and ft_link are mounting interfaces
       whose mass is already counted in link3's 3.9 kg, so they carry token
       values; ee_link carries the handle. -->
  <link name="flange_link">
  <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>

  <link name="ft_link">
  <inertial><mass value="0.001"/><inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6"/></inertial>
  </link>

  <!-- The handle, below the F/T sensor: about 5 kg (platform engineer via the
       owner, 2026-09-23; R5_04 Sec 3 / R5_Q Q-8, provenance C).  This is the
       only mass past ft_link, so it is exactly what the sensor measures in
       free motion: 49.1 N of static weight plus its own inertial force.
       ee_link sits 0.07 m below the sensor along the tool axis and the centre
       of mass is declared 0.03 m further, putting it 0.10 m below the sensor
       as R5_04 Sec 3 specifies ; unknown, and cheap to revise: with three
       prismatic joints and a locked yaw it shifts only the wrench's torque
       channels, never the joint-space dynamics or the force channels.
       Inertia is a 0.15 m box of that mass (5 * 2 * 0.15^2 / 12). -->
  <link name="ee_link">
  <inertial>
    <origin xyz="0 0 0.03" rpy="0 0 0"/>
    <mass value="5.0"/>
    <inertia ixx="0.01875" ixy="0" ixz="0" iyy="0.01875" iyz="0" izz="0.01875"/>
  </inertial>
  </link>

  <joint name="ee_joint" type="fixed">
    <parent link="ft_link"/>
    <child link="ee_link"/>
    <origin xyz="0 0 0.07" rpy="0 0 0"/>
  </joint>

</robot>
